# R4Det environment configuration
# Automatically loaded by direnv when entering the project directory

# Manually activate r4det conda environment
# (direnv auto-reverts variables & PATH when leaving the directory)
source_env_if_exists() {
  if [ -f "$1" ]; then source "$1"; fi
}

# Activate r4det conda environment
CONDA_BASE=$(conda info --base 2>/dev/null)
if [ -n "$CONDA_BASE" ]; then
  source "$CONDA_BASE/etc/profile.d/conda.sh"
  conda activate r4det
fi

# CUDA toolkit path
export CUDA_HOME=/usr/local/cuda-11.8

# Use GCC 11 (CUDA 11.8 supports up to GCC 11)
export CUDAHOSTCXX=/usr/bin/g++-11
export CC=/usr/bin/gcc-11
export CXX=/usr/bin/g++-11

# Specify which GPUs to use
export CUDA_VISIBLE_DEVICES=5,6,7

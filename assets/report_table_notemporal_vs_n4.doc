    <td>46.16</td><td>47.80</td><td>+1.64</td><td>48.98</td><td>+2.81</td></tr>
  <tr><td class="m">Truck 3D moderate strict</td>
    <td>23.48</td><td>28.21</td><td>+4.73</td><td>30.04</td><td>+6.56</td></tr>

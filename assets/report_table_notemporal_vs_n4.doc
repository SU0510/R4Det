  </tr>
  <tr>
    <th>(seed0)</th><th>N4 RSSM</th><th>Δ</th><th>N4 RSSM</th><th>Δ</th>
  </tr>
  <tr>
    <td class="m"><b>Overall 3D moderate</b></td>
    <td>34.65</td><td class="hl">38.39</td><td>+3.74</td><td class="hl">39.40</td><td>+4.75</td>
  </tr>

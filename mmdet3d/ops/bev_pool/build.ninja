ninja_required_version = 1.3
cxx = /usr/bin/g++-11
nvcc = /usr/local/cuda-11.8/bin/nvcc

cflags = -DTORCH_EXTENSION_NAME=bev_pool_ext -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/TH -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/THC -isystem /usr/local/cuda-11.8/include -isystem /home/lurui/envs/miniforge3/envs/r4det/include/python3.8 -D_GLIBCXX_USE_CXX11_ABI=0 -fPIC -std=c++17
post_cflags = 
cuda_cflags = -ccbin /usr/bin/gcc-11 -DTORCH_EXTENSION_NAME=bev_pool_ext -DTORCH_API_INCLUDE_EXTENSION_H -DPYBIND11_COMPILER_TYPE=\"_gcc\" -DPYBIND11_STDLIB=\"_libstdcpp\" -DPYBIND11_BUILD_ABI=\"_cxxabi1011\" -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/TH -isystem /home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/include/THC -isystem /usr/local/cuda-11.8/include -isystem /home/lurui/envs/miniforge3/envs/r4det/include/python3.8 -D_GLIBCXX_USE_CXX11_ABI=0 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr -gencode=arch=compute_89,code=compute_89 -gencode=arch=compute_89,code=sm_89 --compiler-options '-fPIC' -DCUDA_HAS_FP16=1 -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ -std=c++17
cuda_post_cflags = 
cuda_dlink_post_cflags = 
ldflags = -shared -L/home/lurui/envs/miniforge3/envs/r4det/lib/python3.8/site-packages/torch/lib -lc10 -lc10_cuda -ltorch_cpu -ltorch_cuda -ltorch -ltorch_python -L/usr/local/cuda-11.8/lib64 -lcudart

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



rule link
  command = $cxx $in $ldflags -o $out

build bev_pool.o: compile /home/lurui/workspace/R4Det/mmdet3d/ops/bev_pool/src/bev_pool.cpp
build bev_pool_cuda.cuda.o: cuda_compile /home/lurui/workspace/R4Det/mmdet3d/ops/bev_pool/src/bev_pool_cuda.cu



build bev_pool_ext.so: link bev_pool.o bev_pool_cuda.cuda.o

default bev_pool_ext.so

